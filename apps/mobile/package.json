{
  "name": "@hemi/mobile",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5300 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && node scripts/notices.mjs && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5301 --strictPort",
    "sync": "cap sync",
    "ios": "cap open ios",
    "android": "cap open android",
    "doctor": "cap doctor",
    "predev": "node scripts/notices.mjs",
    "test": "node --test test/*.test.mjs",
    "devices:ios": "cap run ios --list",
    "run:ios": "cap run ios"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/browser": "8.0.5",
    "@capacitor/clipboard": "8.0.1",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/keyboard": "8.0.6",
    "@hemi/conversation-flow": "file:../../packages/conversation-flow",
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.16"
  }
}
