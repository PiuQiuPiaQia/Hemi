{
  "name": "@hemi/conversation-flow",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Host-injected conversation state, recovery, drafts, queues and UI for Web, desktop and mobile",
  "files": [
    "dist",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "licenses"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./parts": {
      "types": "./dist/parts.d.ts",
      "import": "./dist/parts.js"
    },
    "./styles.css": "./dist/styles.css",
    "./types": {
      "types": "./dist/types/api.d.ts",
      "import": "./dist/types.js"
    },
    "./web-host": {
      "types": "./dist/adapters/web-host.d.ts",
      "import": "./dist/web-host.js"
    },
    "./native-host": {
      "types": "./dist/adapters/native-host.d.ts",
      "import": "./dist/native-host.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tanstack/react-virtual": "3.14.21",
    "lucide-react": "1.31.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "@types/mdast": "4.0.4",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0",
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2"
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  }
}
